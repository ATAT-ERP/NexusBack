# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Allowed origins separated by commas.
# Local example: http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=

# PostgreSQL / Supabase database
POSTGRES_DB=
POSTGRES_USER=
DB_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# Supabase Auth
SUPABASE_URL=
# Use a publishable or anon key only. Never use or version a service_role or secret key.
SUPABASE_KEY=
