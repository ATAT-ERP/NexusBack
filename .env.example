# Configuración de Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Agregar la IP de red local del equipo para probar desde un teléfono físico.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Los orígenes permitidos se separan con comas.
# Agregar el origen web de la red local si un navegador accede a la API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Opcional: sólo para solicitudes entre orígenes protegidas por CSRF.
CSRF_TRUSTED_ORIGINS=
# Sólo en producción, detrás de un proxy HTTPS de confianza.
DJANGO_TRUST_PROXY_HEADERS=False

# Base de datos PostgreSQL / Supabase
POSTGRES_DB=
POSTGRES_USER=
DB_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Autenticación de Supabase
SUPABASE_URL=
# Usar sólo una clave publicable/anon. No subir credenciales reales a Git.
SUPABASE_KEY=

# Almacenamiento de Supabase
# Secreto exclusivo del servidor; no compartir con PortalWeb ni Orbit.
SUPABASE_SECRET_KEY=

# Límites del almacenamiento de documentos en MB
DOCUMENT_MAX_SIZE_MB=6
DOCUMENT_COMPANY_LIMIT_MB=12
DOCUMENT_STORAGE_SAFE_LIMIT_MB=40
